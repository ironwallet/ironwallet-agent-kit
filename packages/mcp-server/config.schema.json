{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironwallet.io/schemas/mcp-server-env-config.json",
  "title": "IronWallet MCP server environment profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authUrl",
    "relayUrl",
    "swapProxyUrl",
    "evmRpcUrls",
    "tronApiUrl",
    "bitcoinApiUrl",
    "litecoinApiUrl",
    "dogeApiUrl",
    "solanaRpcUrl",
    "tonApiUrl",
    "xrpRpcUrl",
    "bitcoinTestnet"
  ],
  "properties": {
    "authUrl": { "type": "string", "format": "uri" },
    "relayUrl": { "type": "string", "format": "uri" },
    "swapProxyUrl": { "type": "string", "format": "uri" },
    "ratesApiUrl": {
      "type": "string",
      "format": "uri",
      "description": "Rates backend for USD policy limits (/api/v1/rate/rates). Optional: when absent, maxPerTxUsd rejects operations (fail closed)."
    },
    "staticResourcesUrl": {
      "type": "string",
      "format": "uri",
      "description": "MCP proxy base for static resources with per-network asset catalogs (/assets/<branch>/blockchains/...). Optional; tried after staticCdnUrls, with the client headers."
    },
    "staticCdnUrls": {
      "type": "array",
      "description": "Public CDN bases for the same static resources (e.g. https://cdn.iwio.app/Ironwallet), tried in order before staticResourcesUrl. Optional.",
      "items": { "type": "string", "format": "uri", "minLength": 1 }
    },
    "staticAssetsBranch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Static resources branch: main in prod, staging in preprod / dev. Optional; default main."
    },
    "evmRpcUrls": {
      "type": "object",
      "description": "JSON-RPC HTTPS endpoints for EVM chains. Non-EVM networks use the dedicated *ApiUrl / *RpcUrl fields.",
      "additionalProperties": false,
      "required": [
        "ethereum",
        "bsc",
        "polygon",
        "base",
        "arbitrum",
        "optimism",
        "avalanche"
      ],
      "properties": {
        "ethereum": { "type": "string", "format": "uri", "minLength": 1 },
        "bsc": { "type": "string", "format": "uri", "minLength": 1 },
        "polygon": { "type": "string", "format": "uri", "minLength": 1 },
        "base": { "type": "string", "format": "uri", "minLength": 1 },
        "arbitrum": { "type": "string", "format": "uri", "minLength": 1 },
        "optimism": { "type": "string", "format": "uri", "minLength": 1 },
        "avalanche": { "type": "string", "format": "uri", "minLength": 1 }
      }
    },
    "tronApiUrl": { "type": "string" },
    "bitcoinApiUrl": { "type": "string" },
    "litecoinApiUrl": { "type": "string" },
    "dogeApiUrl": { "type": "string" },
    "solanaRpcUrl": { "type": "string" },
    "tonApiUrl": { "type": "string" },
    "xrpRpcUrl": { "type": "string" },
    "bitcoinTestnet": { "type": "boolean" },
    "rpcFallbacks": {
      "type": "object",
      "description": "Extra endpoints per network with the same API as the primary field (evmRpcUrls.<network>, tronApiUrl, bitcoinApiUrl, …), tried in order when the primary is unreachable, times out or answers 429/5xx. bitcoin and litecoin also take a BlockCypher base (https://api.blockcypher.com/v1/ltc/main) next to Esplora hosts. Optional. TON takes none. A primary overridden via env drops these unless IW_RPC_FALLBACK_<NETWORK> is set.",
      "additionalProperties": false,
      "properties": {
        "ethereum": { "$ref": "#/$defs/urlList" },
        "bsc": { "$ref": "#/$defs/urlList" },
        "polygon": { "$ref": "#/$defs/urlList" },
        "base": { "$ref": "#/$defs/urlList" },
        "arbitrum": { "$ref": "#/$defs/urlList" },
        "optimism": { "$ref": "#/$defs/urlList" },
        "avalanche": { "$ref": "#/$defs/urlList" },
        "tron": { "$ref": "#/$defs/urlList" },
        "bitcoin": { "$ref": "#/$defs/urlList" },
        "litecoin": { "$ref": "#/$defs/urlList" },
        "doge": { "$ref": "#/$defs/urlList" },
        "solana": { "$ref": "#/$defs/urlList" },
        "xrp": { "$ref": "#/$defs/urlList" }
      }
    },
    "historyApis": {
      "type": "object",
      "description": "Public explorer chain per network for get_transaction_history, tried in order. Optional; a network with no entry or an empty array reports status=unsupported. Kinds without url fall back to the profile's *ApiUrl / *RpcUrl (blockscout, etherscan, nodereal, tronscan, tonapi always need url; blockcypher needs one outside doge). blockscout takes the REST v2 base (https://<instance>/api/v2).",
      "additionalProperties": false,
      "properties": {
        "ethereum": { "$ref": "#/$defs/historyChain" },
        "bsc": { "$ref": "#/$defs/historyChain" },
        "polygon": { "$ref": "#/$defs/historyChain" },
        "base": { "$ref": "#/$defs/historyChain" },
        "arbitrum": { "$ref": "#/$defs/historyChain" },
        "optimism": { "$ref": "#/$defs/historyChain" },
        "avalanche": { "$ref": "#/$defs/historyChain" },
        "tron": { "$ref": "#/$defs/historyChain" },
        "bitcoin": { "$ref": "#/$defs/historyChain" },
        "litecoin": { "$ref": "#/$defs/historyChain" },
        "doge": { "$ref": "#/$defs/historyChain" },
        "solana": { "$ref": "#/$defs/historyChain" },
        "ton": { "$ref": "#/$defs/historyChain" },
        "xrp": { "$ref": "#/$defs/historyChain" }
      }
    }
  },
  "$defs": {
    "urlList": {
      "type": "array",
      "items": { "type": "string", "format": "uri", "minLength": 1 }
    },
    "historyChain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "blockscout",
              "etherscan",
              "nodereal",
              "tronscan",
              "trongrid",
              "esplora",
              "blockcypher",
              "solana-rpc",
              "toncenter",
              "tonapi",
              "xrp-rpc"
            ]
          },
          "url": { "type": "string", "format": "uri", "minLength": 1 }
        }
      }
    }
  }
}
