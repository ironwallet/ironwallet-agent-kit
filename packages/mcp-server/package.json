{
  "name": "@ironwallet/mcp-server",
  "version": "0.7.1",
  "license": "MIT",
  "description": "Local MCP server for Ironwallet: seed-compatible wallet management, transfers and Swap Proxy swaps for EVM, Tron, Bitcoin, Litecoin, Doge, Solana, XRP and TON.",
  "homepage": "https://ironwallet.io/ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ironwallet/ironwallet-agent-kit.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "bin": {
    "ironwallet-mcp": "dist/cli.js"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@scure/bip32": "^1.7.0",
    "@scure/btc-signer": "^2.2.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "bs58check": "^4.0.0",
    "ethers": "^6.15.0",
    "ripple-binary-codec": "^2.8.0",
    "ripple-keypairs": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
